@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    var currentAvailability = ViewData["CurrentAvailability"] as bool?;
}

<h1>Bookings</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search Booking ID, Event, Venue" />
    </div>
    <div class="col-md-2">
        <select name="eventTypeId" asp-items="ViewBag.EventTypes" class="form-select">
            <option value="">All event types</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="startDate" value="@ViewData["CurrentStartDate"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="endDate" value="@ViewData["CurrentEndDate"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <select name="isAvailable" class="form-select">
            <option value="">All availability</option>
            @if (currentAvailability == true)
            {
                <option value="true" selected>Available venues</option>
            }
            else
            {
                <option value="true">Available venues</option>
            }
            @if (currentAvailability == false)
            {
                <option value="false" selected>Unavailable venues</option>
            }
            else
            {
                <option value="false">Unavailable venues</option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
    <div class="col-md-12">
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Event</th>
            <th>Event Type</th>
            <th>Venue</th>
            <th>Location</th>
            <th>Venue Availability</th>
            <th>Booking Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BookingID</td>
                <td>@item.Event?.EventName</td>
                <td>@item.Event?.EventType?.EventTypeName</td>
                <td>@item.Venue?.VenueName</td>
                <td>@item.Venue?.Location</td>
                <td>@(item.Venue?.IsAvailable == true ? "Available" : "Unavailable")</td>
                <td>@item.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BookingID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.BookingID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.BookingID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
