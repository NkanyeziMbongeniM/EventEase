@model EventEase.Models.Booking

<h2>Delete Booking</h2>

<p>Are you sure you want to delete this booking?</p>
<p><strong>Event:</strong> @Model.Event.EventName</p>
<p><strong>Venue:</strong> @Model.Venue.VenueName</p>
<p><strong>Date:</strong> @Model.BookingDate</p>

<<form asp-action="DeleteConfirmed" asp-route-id="@Model.EventID">
    <input type="hidden" asp-for="BookingID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>