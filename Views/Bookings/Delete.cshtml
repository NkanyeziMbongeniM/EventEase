@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<h2>Delete Booking</h2>

<div class="alert alert-warning">Are you sure you want to delete this booking?</div>

<p><strong>Event:</strong> @Model.Event?.EventName</p>
<p><strong>Venue:</strong> @Model.Venue?.VenueName</p>
<p><strong>Date:</strong> @Model.BookingDate</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookingID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
