@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>

<dl class="row">
    <dt class="col-sm-2">Booking ID</dt>
    <dd class="col-sm-10">@Model.BookingID</dd>
    <dt class="col-sm-2">Event</dt>
    <dd class="col-sm-10">@Model.Event?.EventName</dd>
    <dt class="col-sm-2">Event Type</dt>
    <dd class="col-sm-10">@Model.Event?.EventType?.EventTypeName</dd>
    <dt class="col-sm-2">Venue</dt>
    <dd class="col-sm-10">@Model.Venue?.VenueName</dd>
    <dt class="col-sm-2">Venue Availability</dt>
    <dd class="col-sm-10">@(Model.Venue?.IsAvailable == true ? "Available" : "Unavailable")</dd>
    <dt class="col-sm-2">Booking Date</dt>
    <dd class="col-sm-10">@Model.BookingDate</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BookingID" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
