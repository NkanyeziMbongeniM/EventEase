@model EventEase.Models.Booking
@{
    ViewBag.Events = new SelectList(ViewBag.EventsList, "EventID", "EventName", Model.EventID);
    ViewBag.Venues = new SelectList(ViewBag.VenuesList, "VenueID", "VenueName", Model.VenueID);
}

<h2>Edit Booking</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="BookingID" />
    <div>
        <label asp-for="EventID"></label>
        <select asp-for="EventID" asp-items="ViewBag.Events" class="form-control"></select>
    </div>
    <div>
        <label asp-for="VenueID"></label>
        <select asp-for="VenueID" asp-items="ViewBag.Venues" class="form-control"></select>
    </div>
    <div>
        <label asp-for="BookingDate"></label>
        <input asp-for="BookingDate" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

<a asp-action="Index">Back to List</a>