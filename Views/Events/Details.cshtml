@model EventEase.Models.Event

<h2>Event Details</h2>
<p><strong>Name:</strong> @Model.EventName</p>
<p><strong>Date:</strong> @Model.EventDate.ToString("yyyy-MM-dd HH:mm")</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Venue:</strong> @Model.Venue?.VenueName</p>

<a asp-action="Edit" asp-route-id="@Model.EventID" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
