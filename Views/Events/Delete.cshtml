@model EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h2>Delete Event</h2>
<p class="text-danger">Events linked to active bookings cannot be deleted.</p>
<p>Are you sure you want to delete <strong>@Model.EventName</strong>?</p>

<div class="alert alert-warning">Are you sure you want to delete this event?</div>

<p><strong>Event:</strong> @Model.EventName</p>
<p><strong>Type:</strong> @Model.EventType?.EventTypeName</p>
<p><strong>Venue:</strong> @Model.Venue?.VenueName</p>
<p><strong>Date:</strong> @Model.EventDate</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EventID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
