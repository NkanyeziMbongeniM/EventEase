@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<h2>Delete Venue</h2>

<div class="alert alert-warning">Are you sure you want to delete this venue?</div>

<p><strong>Venue:</strong> @Model.VenueName</p>
<p><strong>Location:</strong> @Model.Location</p>
<p><strong>Availability:</strong> @(Model.IsAvailable ? "Available" : "Unavailable")</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="VenueID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
