@model IEnumerable<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Venues";
    var currentAvailability = ViewData["CurrentAvailability"] as bool?;
}

<h1>Venues</h1>
<partial name="_Alerts" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by venue name or location" />
    </div>
    <div class="col-md-3">
        <select name="isAvailable" class="form-select">
            <option value="">All availability</option>
            @if (currentAvailability == true)
            {
                <option value="true" selected>Available</option>
            }
            else
            {
                <option value="true">Available</option>
            }
            @if (currentAvailability == false)
            {
                <option value="false" selected>Unavailable</option>
            }
            else
            {
                <option value="false">Unavailable</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Venue</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Venue Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Availability</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VenueName</td>
                <td>@item.Location</td>
                <td>@item.Capacity</td>
                <td>@(item.IsAvailable ? "Available" : "Unavailable")</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.VenueName" style="max-width:90px; max-height:70px;" />
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.VenueID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.VenueID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.VenueID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
