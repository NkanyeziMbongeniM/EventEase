@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to EventEase</h1>
    <p class="lead">Manage your events, venues, and bookings easily.</p>

    <div class="d-grid gap-2 d-md-block mt-4">
        <a asp-controller="Events" asp-action="Index" class="btn btn-lg btn-primary me-2">Events</a>
        <a asp-controller="Venues" asp-action="Index" class="btn btn-lg btn-success me-2">Venues</a>
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-lg btn-warning me-2">Bookings</a>
    </div>
</div>